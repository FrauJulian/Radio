<Page x:Class="Radiosender.Views.Pages.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Upload">
    <Grid>
        <StackPanel Margin="24">
            <ui:TextBlock FontTypography="Title" Text="Upload" />
            <ui:TextBlock Margin="0,8,0,0" Text="Add an MP3 or WAV file from your computer to the library." />
            <ui:Button x:Name="ChooseFileButton"
                       Margin="0,16,0,0"
                       Appearance="Primary"
                       Content="Choose file..."
                       Icon="{ui:SymbolIcon ArrowUpload24}"
                       Click="ChooseFileButton_Click" />
        </StackPanel>
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom" />
    </Grid>
</Page>
