<Page x:Class="Radiosender.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Einstellungen"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Loaded="OnLoaded">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Seconds" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Width" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Minimum" Value="5" />
            <Setter Property="Maximum" Value="300" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="MaxDecimalPlaces" Value="0" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Minutes" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Width" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="60" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="MaxDecimalPlaces" Value="0" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
    </Page.Resources>

    <StackPanel MaxWidth="640" Margin="24" HorizontalAlignment="Left">
        <ui:InfoBar x:Name="Message" Margin="0,0,0,12" IsClosable="True" IsOpen="False" />

        <!-- Speaking alerts: one block per kind -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:ToggleSwitch x:Name="NewsAlertSwitch" Grid.ColumnSpan="2" Content="Hinweis vor Nachrichten" />
                <Label Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center"
                       Content="Sekunden vor dem Start"
                       Target="{Binding ElementName=NewsSecondsBox}"
                       IsEnabled="{Binding IsChecked, ElementName=NewsAlertSwitch}" />
                <ui:NumberBox x:Name="NewsSecondsBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                              Style="{StaticResource Seconds}"
                              AutomationProperties.Name="Sekunden vor Nachrichten"
                              IsEnabled="{Binding IsChecked, ElementName=NewsAlertSwitch}" />
                <CheckBox x:Name="NewsSoundBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                          Content="Bing-Ton abspielen"
                          IsEnabled="{Binding IsChecked, ElementName=NewsAlertSwitch}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:ToggleSwitch x:Name="ModeratorAlertSwitch" Grid.ColumnSpan="2" Content="Hinweis vor Moderation" />
                <Label Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center"
                       Content="Sekunden vor dem Start"
                       Target="{Binding ElementName=ModeratorSecondsBox}"
                       IsEnabled="{Binding IsChecked, ElementName=ModeratorAlertSwitch}" />
                <ui:NumberBox x:Name="ModeratorSecondsBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                              Style="{StaticResource Seconds}"
                              AutomationProperties.Name="Sekunden vor Moderation"
                              IsEnabled="{Binding IsChecked, ElementName=ModeratorAlertSwitch}" />
                <CheckBox x:Name="ModeratorSoundBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                          Content="Bing-Ton abspielen"
                          IsEnabled="{Binding IsChecked, ElementName=ModeratorAlertSwitch}" />
            </Grid>
        </Border>

        <!-- Audio devices -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.ColumnSpan="2" FontTypography="BodyStrong" Text="Audio-Ausgabe" />
                <Label Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center"
                       Content="Sendung (für andere)" Target="{Binding ElementName=BroadcastDeviceBox}" />
                <ComboBox x:Name="BroadcastDeviceBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                          AutomationProperties.Name="Ausgabegerät für die Sendung" />
                <Label Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center"
                       Content="Für mich (Kopfhörer)" Target="{Binding ElementName=MonitorDeviceBox}" />
                <ComboBox x:Name="MonitorDeviceBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                          AutomationProperties.Name="Ausgabegerät für mich" />
                <ui:TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Getrennte Lautstärken für dich und für andere brauchen zwei verschiedene Geräte. Mit nur einem Gerät hörst du deinen eigenen Mix." />
            </Grid>
        </Border>

        <!-- Minutes per hour -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.ColumnSpan="2" FontTypography="BodyStrong" Text="Minuten pro Stunde" />
                <Label Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center"
                       Content="Nachrichten" Target="{Binding ElementName=NewsMinutesBox}" />
                <ui:NumberBox x:Name="NewsMinutesBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                              Style="{StaticResource Minutes}" Minimum="2"
                              AutomationProperties.Name="Nachrichten-Minuten pro Stunde" />
                <Label Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center"
                       Content="Moderation" Target="{Binding ElementName=ModeratorMinutesBox}" />
                <ui:NumberBox x:Name="ModeratorMinutesBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                              Style="{StaticResource Minutes}"
                              AutomationProperties.Name="Moderations-Minuten pro Stunde" />
                <Label Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center"
                       Content="Werbung" Target="{Binding ElementName=AdMinutesBox}" />
                <ui:NumberBox x:Name="AdMinutesBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                              Style="{StaticResource Minutes}"
                              AutomationProperties.Name="Werbe-Minuten pro Stunde" />
                <ui:TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Sollwerte, zusammen höchstens 60 Minuten. Gilt für den nächsten Plan." />
            </Grid>
        </Border>

        <!-- laut.fm: live streaming and the station's library -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ui:ToggleSwitch x:Name="LautFmSwitch" Content="laut.fm"
                                 Checked="OnLautFmChanged" Unchecked="OnLautFmChanged" />
                <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Sendet live auf deine laut.fm-Station und bietet ihre Musik beim Import an. Im Plan erscheint dann der Button „Live“." />
                <Grid x:Name="LautFmFields" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Margin="0,12,0,0" Grid.ColumnSpan="2" FontTypography="BodyStrong" Text="Live senden" />
                    <Label Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Server" Target="{Binding ElementName=LautFmHostBox}" />
                    <ui:TextBox x:Name="LautFmHostBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                AutomationProperties.Name="laut.fm-Server" />
                    <Label Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Port" Target="{Binding ElementName=LautFmPortBox}" />
                    <ui:NumberBox x:Name="LautFmPortBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                  Width="130" HorizontalAlignment="Left" Minimum="1" Maximum="65535"
                                  MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False"
                                  AutomationProperties.Name="laut.fm-Port" />
                    <Label Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Mountpoint" Target="{Binding ElementName=LautFmMountBox}" />
                    <ui:TextBox x:Name="LautFmMountBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                AutomationProperties.Name="laut.fm-Mountpoint" />
                    <Label Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Benutzer" Target="{Binding ElementName=LautFmUserBox}" />
                    <ui:TextBox x:Name="LautFmUserBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                                AutomationProperties.Name="laut.fm-Benutzer" />
                    <Label Grid.Row="5" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Passwort" Target="{Binding ElementName=LautFmPasswordBox}" />
                    <ui:PasswordBox x:Name="LautFmPasswordBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                                    AutomationProperties.Name="laut.fm-Passwort" />
                    <ui:TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="Diese Werte stehen in Radioadmin unter „Live senden“." />
                    <ui:TextBlock Grid.Row="7" Margin="0,16,0,0" Grid.ColumnSpan="2" FontTypography="BodyStrong" Text="Bibliothek" />
                    <Label Grid.Row="8" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Stations-ID" Target="{Binding ElementName=LautFmStationBox}" />
                    <ui:TextBox x:Name="LautFmStationBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0"
                                AutomationProperties.Name="laut.fm-Stations-ID" />
                    <Label Grid.Row="9" Margin="0,8,0,0" VerticalAlignment="Center"
                           Content="Radioadmin-Token" Target="{Binding ElementName=LautFmTokenBox}" />
                    <ui:PasswordBox x:Name="LautFmTokenBox" Grid.Row="9" Grid.Column="1" Margin="0,8,0,0"
                                    AutomationProperties.Name="Radioadmin-Token"
                                    ToolTip="Nach dem Login in Radioadmin in den Entwicklertools des Browsers: Lokaler Speicher, Schlüssel laut.fm.api.token." />
                </Grid>
                <ui:TextBlock x:Name="LautFmHint" Margin="0,12,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Passwort und Token werden verschlüsselt für deinen Windows-Benutzer gespeichert. Die Bibliothek nutzt eine nicht offizielle laut.fm-Schnittstelle und kann ohne Vorwarnung ausfallen." />
            </StackPanel>
        </Border>

        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
            <ui:Button Appearance="Primary" MinWidth="110" Content="Speichern" Icon="{ui:SymbolIcon Save24}" Click="OnSave" />
            <ui:Button Margin="8,0,0,0" MinWidth="110" Content="Zurücksetzen" Icon="{ui:SymbolIcon ArrowReset24}"
                       ToolTip="Setzt die Standardwerte ins Formular. Mit Speichern übernehmen."
                       Click="OnReset" />
        </StackPanel>
    </StackPanel>
</Page>
