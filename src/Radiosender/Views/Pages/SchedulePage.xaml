<Page x:Class="Radiosender.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Sendeplan"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">
    <Page.Resources>
        <!-- Type label for the timeline: text names the type, the border color repeats it.
             Songs stay neutral; the accent color can match the news red. -->
        <DataTemplate x:Key="KindChip">
            <Border x:Name="Chip"
                    Padding="8,1"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                <TextBlock x:Name="ChipText" Text="{Binding KindName}" FontSize="12" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="News">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ad">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Moderator">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Wraps on narrow windows instead of cutting off the buttons. -->
        <WrapPanel Grid.Row="1" Margin="0,-8,0,0">
            <ui:TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="Start" />
            <ComboBox x:Name="StartBox"
                      Width="112"
                      Margin="0,8,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Startzeit"
                      DisplayMemberPath="Label"
                      DropDownOpened="OnStartDropDownOpened" />
            <ui:TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="Stunden" />
            <ui:NumberBox x:Name="HoursBox"
                          Width="112"
                          Margin="0,8,12,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Zu planende Stunden"
                          Minimum="1"
                          Maximum="24"
                          Value="1"
                          SmallChange="1"
                          MaxDecimalPlaces="0"
                          ClearButtonEnabled="False" />
            <CheckBox x:Name="UnlimitedBox"
                      MinWidth="0"
                      Margin="0,8,0,0"
                      VerticalAlignment="Center"
                      Content="Unbegrenzt"
                      ToolTip="Ohne Ende: Die nächsten 5 Stunden sind geplant, jede Stunde kommt eine weitere dazu."
                      Checked="OnUnlimitedChanged"
                      Unchecked="OnUnlimitedChanged" />
            <ui:Button x:Name="CreateButton"
                       Margin="0,8,8,0"
                       VerticalAlignment="Center"
                       Appearance="Primary"
                       Content="Plan erstellen"
                       Click="OnCreate" />
            <ui:Button x:Name="StartNowButton"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       Content="Jetzt starten"
                       Icon="{ui:SymbolIcon Play24}"
                       ToolTip="Plant ab diesem Moment und geht sofort auf Sendung. Die Startzeit wird ignoriert."
                       Click="OnStartNow" />
        </WrapPanel>

        <ui:InfoBar x:Name="Message"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <!-- Now playing: what is on air and its buttons on top, the mixing desk below -->
        <Border Grid.Row="3"
                Margin="0,16,0,16"
                Padding="20,16,20,12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Läuft gerade" />
                        <DockPanel Margin="0,4,0,0">
                            <ContentPresenter x:Name="NowKind"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource KindChip}"
                                              Visibility="Collapsed" />
                            <ui:TextBlock x:Name="NowTitle"
                                          FontTypography="Subtitle"
                                          TextTrimming="CharacterEllipsis"
                                          Text="Nichts auf Sendung" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <!-- Live microphone on the program channel; label and icon say whether it is on. -->
                        <ui:Button x:Name="MicButton"
                                   MinWidth="120"
                                   Margin="0,0,20,0"
                                   Content="Mikro ein"
                                   Icon="{ui:SymbolIcon Mic24}"
                                   ToolTip="Schaltet das Mikrofon auf Sendung, auch über laufende Musik."
                                   Click="OnMicToggle" />
                        <ui:Button x:Name="EndNowButton"
                                   Content="Jetzt beenden"
                                   Icon="{ui:SymbolIcon Next24}"
                                   ToolTip="Beendet das laufende Element sofort; das nächste startet."
                                   IsEnabled="False"
                                   Click="OnEndNow" />
                        <!-- One button: Start while idle, Stop while on air. -->
                        <ui:Button x:Name="PlayButton"
                                   MinWidth="110"
                                   Margin="8,0,0,0"
                                   Content="Start"
                                   Icon="{ui:SymbolIcon Play24}"
                                   IsEnabled="False"
                                   Click="OnPlayToggle" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="NowProgress"
                             Margin="0,14,0,0"
                             AutomationProperties.Name="Fortschritt des aktuellen Elements"
                             Maximum="1" />
                <ui:TextBlock x:Name="NowTime"
                              Margin="0,6,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text=" " />

                <Border Height="1" Margin="0,4,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <!-- Mixing desk: three groups of the same width, each a heading with its levels.
                     The groups wrap below each other on a narrow window. -->
                <WrapPanel x:Name="MixPanel" Grid.IsSharedSizeScope="True">
                    <WrapPanel.Resources>
                        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                            <Setter Property="Margin" Value="12,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="Maximum" Value="1" />
                            <Setter Property="SmallChange" Value="0.05" />
                            <Setter Property="LargeChange" Value="0.1" />
                        </Style>
                        <Style x:Key="Group" TargetType="StackPanel">
                            <Setter Property="Width" Value="208" />
                            <Setter Property="Margin" Value="0,0,28,8" />
                        </Style>
                        <Style x:Key="Heading" TargetType="ui:TextBlock">
                            <Setter Property="FontTypography" Value="Caption" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </WrapPanel.Resources>

                    <StackPanel Style="{StaticResource Group}">
                        <ui:TextBlock Style="{StaticResource Heading}" Text="Sendung (für andere)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="Musik" />
                            <Slider x:Name="MusicForOthersSlider" Grid.Column="1"
                                    AutomationProperties.Name="Musik für andere" ValueChanged="OnMixChanged" />
                            <ui:TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Mikrofon" />
                            <Slider x:Name="MicrophoneForOthersSlider" Grid.Row="1" Grid.Column="1"
                                    AutomationProperties.Name="Mikrofon für andere" ValueChanged="OnMixChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}">
                        <ui:TextBlock Style="{StaticResource Heading}" Text="Für mich" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="Musik" />
                            <Slider x:Name="MusicForMeSlider" Grid.Column="1"
                                    AutomationProperties.Name="Musik für mich" ValueChanged="OnMixChanged" />
                            <CheckBox x:Name="ListenToBroadcastBox"
                                      Grid.Row="1" Grid.ColumnSpan="2"
                                      MinWidth="0"
                                      Padding="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="Sendung 1:1 hören"
                                      ToolTip="Du hörst genau das, was andere hören: gleiche Lautstärke von dir, Musik und allem anderen."
                                      Checked="OnMixChanged"
                                      Unchecked="OnMixChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}" Margin="0,0,0,8">
                        <ui:TextBlock Style="{StaticResource Heading}" Text="Musik gesamt" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="Lautstärke" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1"
                                    AutomationProperties.Name="Lautstärke der Musik gesamt" ValueChanged="OnVolumeChanged" />
                        </Grid>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Song request (hot swap) on the left, actions for the selected timeline row on the right -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Songwunsch" />
                <ComboBox x:Name="RequestSong"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          AutomationProperties.Name="Gewünschter Song"
                          DisplayMemberPath="Label"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Label"
                          SelectionChanged="OnRequestChanged" />
                <ui:Button x:Name="SwapButton"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           Content="Auswahl ersetzen"
                           Icon="{ui:SymbolIcon ArrowSwap24}"
                           IsEnabled="False"
                           Click="OnSwap" />
                <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal">
                    <ui:Button x:Name="MoveUpButton"
                               Icon="{ui:SymbolIcon ArrowUp24}"
                               ToolTip="Nach oben"
                               AutomationProperties.Name="Ausgewähltes Element nach oben verschieben"
                               IsEnabled="False"
                               Click="OnMoveUp" />
                    <ui:Button x:Name="MoveDownButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon ArrowDown24}"
                               ToolTip="Nach unten"
                               AutomationProperties.Name="Ausgewähltes Element nach unten verschieben"
                               IsEnabled="False"
                               Click="OnMoveDown" />
                    <ui:Button x:Name="EditItemButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon Edit24}"
                               ToolTip="Titel und Länge bearbeiten"
                               AutomationProperties.Name="Ausgewähltes Element bearbeiten"
                               IsEnabled="False"
                               Click="OnEditItem" />
                    <ui:Button x:Name="RemoveButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="Aus dem Plan entfernen"
                               AutomationProperties.Name="Ausgewähltes Element entfernen"
                               IsEnabled="False"
                               Click="OnRemove" />
                </StackPanel>
            </Grid>
            <ui:TextBlock x:Name="SwapHint"
                          Margin="0,6,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Visibility="Collapsed" />
        </StackPanel>

        <ui:ListView x:Name="Timeline"
                     Grid.Row="5"
                     SelectionMode="Single"
                     IsHitTestVisible="True"
                     AutomationProperties.Name="Sendeplan"
                     SelectionChanged="OnTimelineSelectionChanged"
                     MouseDoubleClick="OnEditItem">
            <ui:ListView.View>
                <ui:GridView>
                    <ui:GridViewColumn Width="36">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon x:Name="OnAir"
                                               Symbol="Play24"
                                               Filled="True"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               AutomationProperties.Name="Auf Sendung"
                                               Visibility="Collapsed" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="OnAir" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="90" Header="Start">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Start" StringFormat="HH:mm:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="120" Header="Typ">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource KindChip}" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="360" Header="Titel" DisplayMemberBinding="{Binding Item.Title}" />
                    <ui:GridViewColumn Width="90" Header="Dauer">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Duration" StringFormat="m\:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <ui:TextBlock x:Name="EmptyText"
                      Grid.Row="5"
                      Margin="0,48,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Noch kein Plan. Stunden wählen und Plan erstellen."
                      Visibility="Visible" />
    </Grid>
</Page>
