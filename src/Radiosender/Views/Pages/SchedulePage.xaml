<Page x:Class="Radiosender.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:Radiosender.Models"
      xmlns:l="clr-namespace:Radiosender.Views"
      Title="{l:Tr Schedule_Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">
    <Page.Resources>
        <!-- Type label for the timeline: text names the type, the border color repeats it.
             Songs stay neutral; the accent color can match the news red. -->
        <DataTemplate x:Key="KindChip">
            <Border x:Name="Chip"
                    Padding="8,1"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                <TextBlock x:Name="ChipText" Text="{Binding KindName}" FontSize="12" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="News">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ad">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Moderator">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Wraps on narrow windows instead of cutting off the buttons. -->
        <WrapPanel Grid.Row="1" Margin="0,-8,0,0">
            <ui:TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="{l:Tr Schedule_Start}" />
            <!-- Editable: pick "Jetzt" or a full hour, or type a time like 14:30 -->
            <ComboBox x:Name="StartBox"
                      Width="112"
                      IsEditable="True"
                      ToolTip="{l:Tr Schedule_StartTimeTip}"
                      Margin="0,8,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{l:Tr Schedule_StartTimeName}"
                      DisplayMemberPath="Label"
                      DropDownOpened="OnStartDropDownOpened" />
            <ui:TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="{l:Tr Schedule_Hours}" />
            <ui:NumberBox x:Name="HoursBox"
                          Width="112"
                          Margin="0,8,12,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Tr Schedule_HoursName}"
                          Minimum="1"
                          Maximum="24"
                          Value="1"
                          SmallChange="1"
                          MaxDecimalPlaces="0"
                          ClearButtonEnabled="False" />
            <CheckBox x:Name="UnlimitedBox"
                      MinWidth="0"
                      Margin="0,8,0,0"
                      VerticalAlignment="Center"
                      Content="{l:Tr Schedule_Unlimited}"
                      ToolTip="{l:Tr Schedule_UnlimitedTip}"
                      Checked="OnUnlimitedChanged"
                      Unchecked="OnUnlimitedChanged" />
            <ui:Button x:Name="CreateButton"
                       Margin="0,8,8,0"
                       VerticalAlignment="Center"
                       Appearance="Primary"
                       Content="{l:Tr Schedule_Create}"
                       Click="OnCreate" />
            <!-- Start: plan from now, play, and go live when laut.fm is on. Stop: ends both. Text set in code. -->
            <ui:Button x:Name="StartNowButton"
                       MinWidth="150"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       Click="OnStartNowToggle" />
        </WrapPanel>

        <ui:InfoBar x:Name="Message"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <!-- Now playing: what is on air and its buttons on top, the mixing desk below -->
        <Border Grid.Row="3"
                Margin="0,16,0,16"
                Padding="20,16,20,12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{l:Tr Schedule_NowPlaying}" />
                        <DockPanel Margin="0,4,0,0">
                            <ContentPresenter x:Name="NowKind"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource KindChip}"
                                              Visibility="Collapsed" />
                            <ui:TextBlock x:Name="NowTitle"
                                          FontTypography="Subtitle"
                                          TextTrimming="CharacterEllipsis"
                                          Text="{l:Tr Schedule_NothingOnAir}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <!-- Live microphone on the program channel; label and icon say whether it is on. -->
                        <ui:Button x:Name="MicButton"
                                   MinWidth="120"
                                   Margin="0,0,20,0"
                                   Content="{l:Tr Schedule_MicOn}"
                                   Icon="{ui:SymbolIcon Mic24}"
                                   ToolTip="{l:Tr Schedule_MicTip}"
                                   Click="OnMicToggle" />
                        <ui:Button x:Name="EndNowButton"
                                   Content="{l:Tr Schedule_EndNow}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="{l:Tr Schedule_EndNowTip}"
                                   IsEnabled="False"
                                   Click="OnEndNow" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="NowProgress"
                             Margin="0,14,0,0"
                             AutomationProperties.Name="{l:Tr Schedule_ProgressName}"
                             Maximum="1" />
                <ui:TextBlock x:Name="NowTime"
                              Margin="0,6,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text=" " />

                <Border Height="1" Margin="0,4,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <!-- Mixing desk: three groups of the same width, each a heading with its levels.
                     The groups wrap below each other on a narrow window. -->
                <WrapPanel x:Name="MixPanel" Grid.IsSharedSizeScope="True">
                    <WrapPanel.Resources>
                        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                            <Setter Property="Margin" Value="12,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="Maximum" Value="1" />
                            <Setter Property="SmallChange" Value="0.05" />
                            <Setter Property="LargeChange" Value="0.1" />
                        </Style>
                        <Style x:Key="Group" TargetType="StackPanel">
                            <Setter Property="Width" Value="208" />
                            <Setter Property="Margin" Value="0,0,28,8" />
                        </Style>
                        <Style x:Key="Heading" TargetType="ui:TextBlock">
                            <Setter Property="FontTypography" Value="Caption" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </WrapPanel.Resources>

                    <StackPanel Style="{StaticResource Group}">
                        <ui:TextBlock Style="{StaticResource Heading}" Text="{l:Tr Schedule_MixListeners}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Schedule_Music}" />
                            <Slider x:Name="MusicForOthersSlider" Grid.Column="1"
                                    AutomationProperties.Name="{l:Tr Schedule_MusicForListenersName}" ValueChanged="OnMixChanged" />
                            <ui:TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{l:Tr Schedule_Microphone}" />
                            <Slider x:Name="MicrophoneForOthersSlider" Grid.Row="1" Grid.Column="1"
                                    AutomationProperties.Name="{l:Tr Schedule_MicForListenersName}" ValueChanged="OnMixChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}" Margin="0,0,0,8">
                        <ui:TextBlock Style="{StaticResource Heading}" Text="{l:Tr Schedule_MixYou}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Schedule_Music}" />
                            <Slider x:Name="MusicForMeSlider" Grid.Column="1"
                                    AutomationProperties.Name="{l:Tr Schedule_MusicForMeName}"
                                    ToolTip="{l:Tr Schedule_MusicForMeTip}"
                                    ValueChanged="OnMixChanged" />
                            <CheckBox x:Name="ListenToBroadcastBox"
                                      Grid.Row="1" Grid.ColumnSpan="2"
                                      MinWidth="0"
                                      Padding="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="{l:Tr Schedule_SameAsListeners}"
                                      ToolTip="{l:Tr Schedule_SameAsListenersTip}"
                                      Checked="OnMixChanged"
                                      Unchecked="OnMixChanged" />
                        </Grid>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Song request (hot swap) on the left, actions for the selected timeline row on the right -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{l:Tr Schedule_RequestLabel}" />
                <ComboBox x:Name="RequestSong"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          AutomationProperties.Name="{l:Tr Schedule_RequestName}"
                          DisplayMemberPath="Label"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Label"
                          SelectionChanged="OnRequestChanged" />
                <ui:Button x:Name="SwapButton"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           Content="{l:Tr Schedule_Swap}"
                           Icon="{ui:SymbolIcon ArrowSwap24}"
                           IsEnabled="False"
                           Click="OnSwap" />
                <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal">
                    <!-- Inserts as the one after next -->
                    <ui:DropDownButton x:Name="AddButton"
                                       Margin="0,0,8,0"
                                       Content="{l:Tr Schedule_Add}"
                                       Icon="{ui:SymbolIcon Add24}"
                                       ToolTip="{l:Tr Schedule_AddTip}"
                                       IsEnabled="False">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{l:Tr Schedule_AddSong}" Tag="{x:Static models:ScheduleItemKind.Song}" Click="OnAddItem" />
                                <MenuItem Header="{l:Tr Kind_News}" Tag="{x:Static models:ScheduleItemKind.News}" Click="OnAddItem" />
                                <MenuItem Header="{l:Tr Kind_Ad}" Tag="{x:Static models:ScheduleItemKind.Ad}" Click="OnAddItem" />
                                <MenuItem Header="{l:Tr Kind_Moderator}" Tag="{x:Static models:ScheduleItemKind.Moderator}" Click="OnAddItem" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button x:Name="MoveUpButton"
                               Icon="{ui:SymbolIcon ArrowUp24}"
                               ToolTip="{l:Tr Schedule_MoveUp}"
                               AutomationProperties.Name="{l:Tr Schedule_MoveUpName}"
                               IsEnabled="False"
                               Click="OnMoveUp" />
                    <ui:Button x:Name="MoveDownButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon ArrowDown24}"
                               ToolTip="{l:Tr Schedule_MoveDown}"
                               AutomationProperties.Name="{l:Tr Schedule_MoveDownName}"
                               IsEnabled="False"
                               Click="OnMoveDown" />
                    <ui:Button x:Name="EditItemButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon Edit24}"
                               ToolTip="{l:Tr Schedule_EditTip}"
                               AutomationProperties.Name="{l:Tr Schedule_EditName}"
                               IsEnabled="False"
                               Click="OnEditItem" />
                    <ui:Button x:Name="RemoveButton"
                               Margin="4,0,0,0"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="{l:Tr Schedule_RemoveTip}"
                               AutomationProperties.Name="{l:Tr Schedule_RemoveName}"
                               IsEnabled="False"
                               Click="OnRemove" />
                </StackPanel>
            </Grid>
            <ui:TextBlock x:Name="SwapHint"
                          Margin="0,6,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Visibility="Collapsed" />
        </StackPanel>

        <ui:ListView x:Name="Timeline"
                     Grid.Row="5"
                     SelectionMode="Single"
                     IsHitTestVisible="True"
                     AutomationProperties.Name="{l:Tr Schedule_Title}"
                     AllowDrop="True"
                     SelectionChanged="OnTimelineSelectionChanged"
                     MouseDoubleClick="OnEditItem"
                     PreviewMouseLeftButtonDown="OnTimelineMouseDown"
                     PreviewMouseMove="OnTimelineMouseMove"
                     DragOver="OnTimelineDragOver"
                     DragLeave="OnTimelineDragLeave"
                     Drop="OnTimelineDrop">
            <ui:ListView.View>
                <ui:GridView>
                    <ui:GridViewColumn Width="36">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ui:SymbolIcon x:Name="OnAir"
                                                   Symbol="Play24"
                                                   Filled="True"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   AutomationProperties.Name="{l:Tr Schedule_OnAirName}"
                                                   Visibility="Collapsed" />
                                    <!-- Grip on hover or selection: the row can be dragged -->
                                    <ui:SymbolIcon x:Name="Grip"
                                                   Symbol="ReOrderDotsVertical24"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Cursor="SizeAll"
                                                   ToolTip="{l:Tr Schedule_DragTip}"
                                                   Visibility="Hidden" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="OnAir" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanMove}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanMove}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="90" Header="{l:Tr Schedule_Start}">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Start" StringFormat="HH:mm:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="120" Header="{l:Tr Schedule_ColType}">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource KindChip}" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="360" Header="{l:Tr Schedule_ColTitle}" DisplayMemberBinding="{Binding Item.Title}" />
                    <ui:GridViewColumn Width="90" Header="{l:Tr Schedule_ColDuration}">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Duration" StringFormat="m\:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <ui:TextBlock x:Name="EmptyText"
                      Grid.Row="5"
                      Margin="0,48,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{l:Tr Schedule_Empty}"
                      Visibility="Visible" />
    </Grid>
</Page>
