<Page x:Class="Radiosender.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Schedule"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">
    <Page.Resources>
        <!-- Type label for the timeline: text names the type, the border color repeats it.
             Songs stay neutral; the accent color can match the news red. -->
        <DataTemplate x:Key="KindChip">
            <Border x:Name="Chip"
                    Padding="8,1"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock x:Name="ChipText" Text="{Binding Kind}" FontSize="12" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="News">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ad">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Moderator">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="Schedule" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal">
            <ui:TextBlock VerticalAlignment="Center" Text="Hours" />
            <ui:NumberBox x:Name="HoursBox"
                          Width="140"
                          Margin="12,0,0,0"
                          AutomationProperties.Name="Hours to plan"
                          Minimum="1"
                          Maximum="24"
                          Value="1"
                          SmallChange="1"
                          MaxDecimalPlaces="0"
                          ClearButtonEnabled="False" />
            <ui:Button Margin="12,0,0,0"
                       Appearance="Primary"
                       Content="Create schedule"
                       Icon="{ui:SymbolIcon CalendarLtr24}"
                       Click="OnCreate" />
        </StackPanel>

        <ui:InfoBar x:Name="Message"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <!-- Now playing -->
        <Border Grid.Row="3"
                Margin="0,16,0,16"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="Now playing" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <ContentPresenter x:Name="NowKind"
                                          VerticalAlignment="Center"
                                          ContentTemplate="{StaticResource KindChip}"
                                          Visibility="Collapsed" />
                        <ui:TextBlock x:Name="NowTitle"
                                      Margin="8,0,0,0"
                                      FontTypography="Subtitle"
                                      TextTrimming="CharacterEllipsis"
                                      Text="Nothing on air" />
                    </StackPanel>
                    <ProgressBar x:Name="NowProgress"
                                 Margin="0,12,0,0"
                                 AutomationProperties.Name="Progress of the current item"
                                 Maximum="1" />
                    <ui:TextBlock x:Name="NowTime"
                                  Margin="0,6,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text=" " />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="StartButton"
                                   Content="Start"
                                   Icon="{ui:SymbolIcon Play24}"
                                   IsEnabled="False"
                                   Click="OnStart" />
                        <ui:Button x:Name="StopButton"
                                   Margin="8,0,0,0"
                                   Content="Stop"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   IsEnabled="False"
                                   Click="OnStop" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:SymbolIcon VerticalAlignment="Center" Symbol="Speaker224" />
                        <Slider x:Name="VolumeSlider"
                                Width="140"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volume"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                ValueChanged="OnVolumeChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Song request (hot swap) -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Song request" />
            <ComboBox x:Name="RequestSong"
                      Grid.Column="1"
                      Margin="12,0,0,0"
                      AutomationProperties.Name="Requested song"
                      DisplayMemberPath="Label"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Label"
                      SelectionChanged="OnRequestChanged" />
            <ui:Button x:Name="SwapButton"
                       Grid.Column="2"
                       Margin="12,0,0,0"
                       Content="Play instead of selected"
                       Icon="{ui:SymbolIcon ArrowSwap24}"
                       IsEnabled="False"
                       Click="OnSwap" />
            <ui:TextBlock x:Name="SwapHint"
                          Grid.Column="3"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextTrimming="CharacterEllipsis"
                          Text="Select an upcoming item in the schedule." />
        </Grid>

        <ui:ListView x:Name="Timeline"
                     Grid.Row="5"
                     SelectionMode="Single"
                     IsHitTestVisible="True"
                     AutomationProperties.Name="Schedule timeline"
                     SelectionChanged="OnTimelineSelectionChanged">
            <ui:ListView.View>
                <ui:GridView>
                    <ui:GridViewColumn Width="36">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon x:Name="OnAir"
                                               Symbol="Play24"
                                               Filled="True"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               AutomationProperties.Name="On air"
                                               Visibility="Collapsed" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="OnAir" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="90" Header="Start">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Start" StringFormat="HH:mm:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="120" Header="Type">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource KindChip}" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="420" Header="Title" DisplayMemberBinding="{Binding Item.Title}" />
                    <ui:GridViewColumn Width="90" Header="Duration">
                        <ui:GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Item.Duration" StringFormat="m\:ss" />
                        </ui:GridViewColumn.DisplayMemberBinding>
                    </ui:GridViewColumn>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <ui:TextBlock x:Name="EmptyText"
                      Grid.Row="5"
                      Margin="0,48,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Text="No schedule yet. Choose the hours and create one."
                      Visibility="Visible" />
    </Grid>
</Page>
