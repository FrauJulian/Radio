<Page x:Class="Radiosender.Views.Pages.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Radiosender.Views"
      Title="{l:Tr Import_Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Sources" Grid.Row="1">
            <TabControl.Resources>
                <!-- The theme barely marks the selected tab, so the header shows it itself: bold text and an accent line. -->
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock x:Name="Label"
                                               Text="{Binding}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border x:Name="Mark" Height="3" Margin="0,4,0,0" CornerRadius="1.5" Background="Transparent" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- From computer -->
            <TabItem Header="{l:Tr Import_TabComputer}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DropZone"
                          Background="Transparent"
                          AllowDrop="True"
                          AutomationProperties.Name="{l:Tr Import_DropZoneName}"
                          DragEnter="OnDragOver"
                          DragOver="OnDragOver"
                          DragLeave="OnDragLeave"
                          Drop="OnDrop">
                        <Rectangle x:Name="DropBorder"
                                   RadiusX="8"
                                   RadiusY="8"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3"
                                   Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Symbol="ArrowUpload24" />
                            <ui:TextBlock Margin="0,8,0,12"
                                          HorizontalAlignment="Center"
                                          FontTypography="BodyStrong"
                                          Text="{l:Tr Import_DropHint}" />
                            <ui:Button x:Name="ChooseFilesButton"
                                       HorizontalAlignment="Center"
                                       Appearance="Primary"
                                       Content="{l:Tr Import_ChooseFiles}"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Click="OnChooseFiles" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="UploadProgressPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                        <ui:TextBlock x:Name="UploadProgressText" />
                        <ProgressBar x:Name="UploadProgress"
                                     Margin="0,6,0,0"
                                     AutomationProperties.Name="{l:Tr Import_ProgressName}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Searches all providers in parallel -->
            <TabItem x:Name="OnlineTab" Header="{l:Tr Import_TabOnline}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Multiselect: checkable items filled from LicenseType.All in code -->
                        <ui:DropDownButton x:Name="LicenseButton"
                                           MinWidth="150"
                                           Margin="0,0,8,0"
                                           AutomationProperties.Name="{l:Tr Import_LicensesName}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="LicenseMenu" />
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:TextBox x:Name="QueryBox"
                                    Grid.Column="1"
                                    PlaceholderText="{l:Tr Import_SearchPlaceholder}"
                                    AutomationProperties.Name="{l:Tr Import_QueryName}"
                                    KeyDown="OnQueryKeyDown" />
                        <ui:Button x:Name="SearchButton"
                                   Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Appearance="Primary"
                                   Content="{l:Tr Import_Search}"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Click="OnSearch" />
                    </Grid>

                    <ui:InfoBar x:Name="Message" Grid.Row="1" Margin="0,12,0,0" IsClosable="True" />

                    <ui:ListView x:Name="Results"
                                 Grid.Row="2"
                                 Margin="0,12,0,0"
                                 SelectionMode="Extended"
                                 AutomationProperties.Name="{l:Tr Import_ResultsName}"
                                 SelectionChanged="OnSelectionChanged"
                                 MouseDoubleClick="OnResultDoubleClick">
                        <ui:ListView.View>
                            <ui:GridView>
                                <ui:GridViewColumn Width="300" Header="{l:Tr Song_Title}" DisplayMemberBinding="{Binding Track.Title}" />
                                <ui:GridViewColumn Width="180" Header="{l:Tr Import_ColCreator}" DisplayMemberBinding="{Binding Track.Creator}" />
                                <ui:GridViewColumn Width="80" Header="{l:Tr Song_Duration}" DisplayMemberBinding="{Binding Track.DurationText}" />
                                <ui:GridViewColumn Width="130" Header="{l:Tr Song_License}" DisplayMemberBinding="{Binding Track.License}" />
                                <ui:GridViewColumn Width="130" Header="{l:Tr Import_ColSource}" DisplayMemberBinding="{Binding Source}" />
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button x:Name="PreviewButton" MinWidth="110" Content="{l:Tr Import_Preview}" Icon="{ui:SymbolIcon Play24}"
                                   IsEnabled="False" Click="OnPreview" />
                        <ui:Button x:Name="ImportButton" ToolTipService.ShowOnDisabled="True" Margin="8,0,0,0" Appearance="Primary"
                                   Content="{l:Tr Import_ImportButton}" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   IsEnabled="False" Click="OnImport" />
                        <ui:ProgressRing x:Name="Busy"
                                         Width="20"
                                         Height="20"
                                         Margin="12,0,0,0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        <ui:TextBlock x:Name="BusyText"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Results of this session from both sources; hidden until something was imported. -->
        <Grid x:Name="SessionPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="{l:Tr Import_SessionTitle}" />
            <ui:Button HorizontalAlignment="Right"
                       Appearance="Transparent"
                       Content="{l:Tr Import_OpenLibrary}"
                       Icon="{ui:SymbolIcon MusicNote224}"
                       Click="OnOpenLibrary" />
            <ui:ListView x:Name="Session"
                         Grid.Row="1"
                         MaxHeight="200"
                         Margin="0,8,0,0"
                         AutomationProperties.Name="{l:Tr Import_SessionName}">
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Width="160" Header="{l:Tr Import_ColStatus}">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="Icon"
                                                       Symbol="CheckmarkCircle24"
                                                       Filled="True"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <ui:TextBlock x:Name="Label" Margin="6,0,0,0" Text="{l:Tr Import_StatusAdded}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                            <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="Label" Property="Text" Value="{l:Tr Import_StatusFailed}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn Width="240" Header="{l:Tr Song_Title}" DisplayMemberBinding="{Binding Title}" />
                        <ui:GridViewColumn Width="160" Header="{l:Tr Song_Artist}" DisplayMemberBinding="{Binding Artist}" />
                        <ui:GridViewColumn Width="320" Header="{l:Tr Import_ColDetails}" DisplayMemberBinding="{Binding Details}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </Grid>
    </Grid>
</Page>
