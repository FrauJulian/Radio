<Page x:Class="Radiosender.Views.Pages.OpenversePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Openverse"
      Unloaded="OnUnloaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="Openverse" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="QueryBox"
                        PlaceholderText="Search free audio, for example &quot;jazz piano&quot;"
                        AutomationProperties.Name="Search term"
                        KeyDown="OnQueryKeyDown" />
            <ui:Button x:Name="SearchButton" Grid.Column="1" Margin="8,0,0,0"
                       Appearance="Primary" Content="Search"
                       Icon="{ui:SymbolIcon Search24}"
                       Click="OnSearch" />
        </Grid>

        <ui:InfoBar x:Name="Message" Grid.Row="2" Margin="0,12,0,0" IsClosable="True" />

        <ui:ListView x:Name="Results" Grid.Row="3" Margin="0,12,0,0"
                     SelectionMode="Single"
                     AutomationProperties.Name="Search results"
                     SelectionChanged="OnSelectionChanged">
            <ui:ListView.View>
                <ui:GridView>
                    <GridViewColumn Header="Title" Width="320" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Creator" Width="200" DisplayMemberBinding="{Binding Creator}" />
                    <GridViewColumn Header="Duration" Width="90" DisplayMemberBinding="{Binding DurationText}" />
                    <GridViewColumn Header="License" Width="150" DisplayMemberBinding="{Binding LicenseName}" />
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal">
            <ui:Button x:Name="PreviewButton" Content="Preview" Icon="{ui:SymbolIcon Play24}"
                       IsEnabled="False" Click="OnPreview" />
            <ui:Button x:Name="StopButton" Margin="8,0,0,0" Content="Stop" Icon="{ui:SymbolIcon Stop24}"
                       IsEnabled="False" Click="OnStop" />
            <ui:Button x:Name="ImportButton" Margin="8,0,0,0" Appearance="Primary"
                       Content="Import to library" Icon="{ui:SymbolIcon ArrowDownload24}"
                       IsEnabled="False" Click="OnImport" />
            <ui:TextBlock x:Name="ImportHint" Margin="12,0,0,0" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Text="This result has no duration and cannot be imported." />
        </StackPanel>
    </Grid>
</Page>
