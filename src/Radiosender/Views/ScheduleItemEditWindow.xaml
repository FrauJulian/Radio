<ui:FluentWindow x:Class="Radiosender.Views.ScheduleItemEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Radiosender.Views"
                 Title="{l:Tr ItemEdit_Window}"
                 Width="400" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" Title="{l:Tr ItemEdit_Window}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,8,24,24">
            <Label Content="{l:Tr ItemEdit_TitleLabel}" Target="{Binding ElementName=TitleBox}" />
            <ui:TextBox x:Name="TitleBox" Margin="0,0,0,12" PlaceholderText="{l:Tr ItemEdit_Optional}" />

            <Label x:Name="DurationLabel" Content="{l:Tr ItemEdit_Length}" Target="{Binding ElementName=DurationBox}" />
            <ui:TextBox x:Name="DurationBox" />


            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="SaveButton" Content="{l:Tr ItemEdit_Save}" Appearance="Primary" IsDefault="True" MinWidth="90" Click="OnSave" />
                <ui:Button Margin="8,0,0,0" Content="{l:Tr ItemEdit_Cancel}" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
