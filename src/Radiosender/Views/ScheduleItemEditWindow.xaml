<ui:FluentWindow x:Class="Radiosender.Views.ScheduleItemEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Element bearbeiten"
                 Width="400" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" Title="Element bearbeiten" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,8,24,24">
            <Label Content="_Titel" Target="{Binding ElementName=TitleBox}" />
            <ui:TextBox x:Name="TitleBox" Margin="0,0,0,12" PlaceholderText="Optional" />

            <Label x:Name="DurationLabel" Content="_Länge (m:ss)" Target="{Binding ElementName=DurationBox}" />
            <ui:TextBox x:Name="DurationBox" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="Länge als Minuten und Sekunden eingeben, zum Beispiel 5:00."
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Content="Speichern" Appearance="Primary" IsDefault="True" MinWidth="90" Click="OnSave" />
                <ui:Button Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
