<ui:FluentWindow x:Class="Radiosender.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Radiosender.Views.Pages"
                 Title="Radiosender"
                 Width="1100" Height="700"
                 MinWidth="800" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Radiosender" />

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem Content="Library"
                                       Icon="{ui:SymbolIcon MusicNote224}"
                                       TargetPageType="{x:Type pages:LibraryPage}" />
                <ui:NavigationViewItem Content="Openverse"
                                       Icon="{ui:SymbolIcon Search24}"
                                       TargetPageType="{x:Type pages:OpenversePage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
